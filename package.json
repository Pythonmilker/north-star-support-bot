{
  "name": "north-star-support-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable customer-support chat widget for an outdoor apparel & camping gear store.",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
